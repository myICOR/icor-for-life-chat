      "template": null,
      "icon": null,
      "owner": "plugin",
      "required": [
        "external_id",
        "priority",
        "source",
        "status",
        "title"
      ],
      "fields": [
        "created",
        "created_at",
        "done_at",
        "done_local",
        "due",
        "due_string",
        "external_id",
