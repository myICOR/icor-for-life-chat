    "planner-routine": {
      "label": "Planner routine",
      "description": "",
      "folder": null,
      "template": null,
      "icon": null,
      "owner": "plugin",
      "required": [
        "active",
        "end",
        "name",
        "routine_type",
        "start",
        "weekdays"
      ],
      "fields": [
        "active",
        "created",
        "created_at",
        "end",
        "name",
        "routine_type",
        "start",
        "tags",
